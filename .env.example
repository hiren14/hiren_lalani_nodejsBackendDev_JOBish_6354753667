# Placeholder values only. Copy to .env for local (non-Docker) runs.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5433/messaging
REDIS_URL=redis://localhost:6380

# Use a long random string in real environments (>= 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-value
JWT_EXPIRES_IN=1h

# Shared secret the provider exchanges for a short-lived provider JWT
PROVIDER_API_KEY=change-me-provider-api-key

# Queue dashboard (Bull Board) at /admin/queues. Leave ADMIN_PASSWORD empty to disable it.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# BullMQ worker tuning
WORKER_CONCURRENCY=5
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=1000
